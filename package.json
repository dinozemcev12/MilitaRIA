{
  "name": "militaria",
  "version": "0.1.0",
  "description": "MilitaRIA — Grand Strategy & Real-Time Tactical Warfare",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.militaria.game",
    "productName": "MilitaRIA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "simplex-noise": "^4.0.1",
    "three": "^0.165.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "@types/topojson-client": "^3.1.5",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
